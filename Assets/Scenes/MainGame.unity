      foodDays: 0
      income: 0
      delayDays: 0
      mood: 0
      isWork: 0
      isRecovery: 0
      action: 11
    tipKey: reminder
  - day: 7
    id: work_7
    title: WEEKEND PLANS
    body: Your manager asks if you are free. This is not an invitation to lunch.
