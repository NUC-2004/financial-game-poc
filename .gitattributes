* text=auto

# Keep Unity text assets and source files consistent across operating systems.
*.cs text eol=lf
*.shader text eol=lf
*.cginc text eol=lf
*.compute text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.meta text eol=lf
*.json text eol=lf
*.md text eol=lf

# Do not treat imported media as text.
*.png binary
*.jpg binary
*.jpeg binary
*.psd binary
*.fbx binary
*.wav binary
*.mp3 binary
*.ogg binary
